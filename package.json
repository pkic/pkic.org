{
  "name": "pkic-org-events-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite dev --host 0.0.0.0 --port 8788",
    "dev:hugo": "hugo serve",
    "build": "vite build",
    "build:preview": "CLOUDFLARE_ENV=preview vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "preview": "pnpm run build && vite preview --host 0.0.0.0 --port 8788",
    "deploy:production": "pnpm run build:production && wrangler deploy",
    "deploy:preview": "pnpm run build:preview && wrangler deploy",
    "typecheck": "pnpm run typecheck:backend && pnpm run typecheck:frontend && pnpm run typecheck:tools",
    "typecheck:backend": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test": "pnpm run test:backend && pnpm run test:frontend && pnpm run test:tools",
    "test:backend": "vitest run --config vitest.config.ts",
    "test:frontend": "vitest run --config vitest.config.frontend.ts",
    "test:tools": "vitest run --config vitest.config.tools.ts",
    "test:workflows": "vitest run --config vitest.config.ts tests/full-workflow.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:max-lines": "node scripts/check-max-lines.mjs",
    "check:filenames": "node scripts/check-filename-collisions.mjs",
    "generate:public": "node scripts/build-frontend.mjs --dev && hugo -e development --cleanDestinationDir",
    "lint": "eslint . --max-warnings 0",
    "lint:architecture": "depcruise functions assets/shared assets/ts assets/js scripts static/scripts --config .dependency-cruiser.cjs",
    "lint:duplication": "node scripts/check-duplication.mjs",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"functions/**/*.ts\" \"assets/ts/**/*.{ts,tsx}\" \"assets/shared/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"functions/**/*.ts\" \"assets/ts/**/*.{ts,tsx}\" \"assets/shared/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:architecture && pnpm run lint:duplication && pnpm run format:check && pnpm run generate:public && pnpm run test && pnpm run check:max-lines && pnpm run check:filenames",
    "migrate:local": "pnpm exec wrangler d1 migrations apply DB --env local --local",
    "migrate:preview": "pnpm exec wrangler d1 migrations apply DB --env preview --remote",
    "migrate:production": "pnpm exec wrangler d1 migrations apply DB --env production --remote",
    "backup:local": "mkdir -p backups/d1 && f=backups/d1/local-$(date +%Y%m%d-%H%M%S).sql && pnpm exec wrangler d1 export DB --env local --local --output \"$f\" && node scripts/reorder-d1-dump.mjs \"$f\"",
    "backup:preview": "mkdir -p backups/d1 && f=backups/d1/preview-$(date +%Y%m%d-%H%M%S).sql && pnpm exec wrangler d1 export DB --env preview --remote --output \"$f\" && node scripts/reorder-d1-dump.mjs \"$f\"",
    "backup:production": "mkdir -p backups/d1 && f=backups/d1/production-$(date +%Y%m%d-%H%M%S).sql && pnpm exec wrangler d1 export DB --env production --remote --output \"$f\" && node scripts/reorder-d1-dump.mjs \"$f\"",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:preview": "node scripts/seed.mjs --preview",
    "seed:production": "node scripts/seed.mjs --production"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.3.8",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@preact/signals": "^2.9.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "agents": "^0.13.3",
    "chanfana": "^3.3.0",
    "client-zip": "^2.5.0",
    "handlebars": "^4.7.9",
    "hono": "^4.12.34",
    "ical.js": "^2.2.1",
    "marked": "^17.0.6",
    "postal-mime": "^2.7.4",
    "preact": "^10.29.2",
    "wouter": "^3.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "dependency-cruiser": "18.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "17.11.0",
    "jscpd": "^5.0.16",
    "jsdom": "^27.4.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.103.0"
  }
}
