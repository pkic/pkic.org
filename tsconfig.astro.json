{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["astro/client", "node", "@cloudflare/workers-types"],
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "site/**/*", "assets/shared/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
