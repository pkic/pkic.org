// Operations config for the shared Preview D1 database. Workers Previews bind
// DB to pkic-db-preview through env.production.previews in wrangler.jsonc;
// this file addresses the same database for migrations, seeds, and backups.
// Keep database_name and database_id identical to that previews binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkic-org-preview-migrations",
  "account_id": "dd9c5d7f73f7d170f3e2c1108fc84bb3",
  "compatibility_date": "2026-03-17",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "pkic-db-preview",
      "database_id": "0647ba62-4bf0-40e5-b547-62f992acbbf0",
      "migrations_dir": "migrations",
    },
  ],
}
