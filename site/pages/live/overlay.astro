---
/*
 * One page for every room's broadcast overlays. The whole address rides the
 * fragment, which never reaches a server, so the page stays static.
 */
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1920, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Live session overlay</title>
  </head>
  <body>
    <div id="live-overlay"></div>
    <script>import "../../../assets/ts/live-session/overlay-page";</script>
  </body>
</html>
