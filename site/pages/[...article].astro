---
import PublicPage from "../layouts/PublicPage.astro";
import { SitePageBody } from "../../assets/ts/site/SitePageBody";
import { loadSiteContent, loadSiteContentMetadata, siteAgendaPageRoutes, publishedSiteRoutes, siteMapEntries } from "../../functions/_lib/services/site-content";
import { publication, memberCounts } from "../publication";
import { publicationPageInputs } from "../publication-page-inputs";
import { publicationRouteCacheKey } from "../publication-cache";
import { renderSiteContentHero } from "../../functions/_lib/services/site-content-resolution";
export async function getStaticPaths() {
  const dedicated = new Set(["/members/", "/members/independent/", "/members/profile/", "/portal/", "/search/", "/news/", "/votes/", "/votes/detail/", "/wg/pkimm/"]);
  const routes = new Set([...publishedSiteRoutes(), ...siteMapEntries().map(({ route }) => route), ...(publication.eventFlows ?? []).map(page => page.route)]);
  const agendaChildren = siteAgendaPageRoutes(publication);
  const agendaBySource = new Map(agendaChildren.map((child) => [child.sourceRoute, { agendaBasePath: child.agendaBasePath }]));
  const ownedRoutes = new Map<string, { sourceRoute: string; agendaRoute?: { agendaBasePath: string; initialDay?: string } }>([...routes].map((route) => [route, { sourceRoute: route, agendaRoute: agendaBySource.get(route) }]));
  for (const child of agendaChildren) {
    if (ownedRoutes.has(child.route)) throw new Error(`Agenda child collides with a published route: ${child.route}`);
    ownedRoutes.set(child.route, { sourceRoute: child.sourceRoute, agendaRoute: { agendaBasePath: child.agendaBasePath, initialDay: child.initialDay } });
  }
  const pages = [];
  for (const [route, { sourceRoute, agendaRoute }] of ownedRoutes) {
    if (dedicated.has(route)) continue;
    const entry = await loadSiteContentMetadata(sourceRoute, { publication });
    if (!entry || entry.metadata.draft || entry.metadata.redirect) continue;
    const hero = entry.plainMarkdown === undefined ? undefined : await renderSiteContentHero(entry.metadata, entry.rawDescription);
    const content = hero ? { ...entry.metadata, hero } : entry.metadata;
    const pageInputs = entry.plainMarkdown === undefined ? undefined : await publicationPageInputs({
      route, title: content.title, description: content.description, accent: content.pageAccent, robots: content.robots, content,
    });
    pages.push({
      params: { article: route === "/" ? undefined : route.replace(/^\/|\/$/g, "") },
      props: { route, sourceRoute, agendaRoute, pageInputs, hero },
      ...(pageInputs?.imageInputs.cacheable ? { cacheKey: publicationRouteCacheKey(route, {
        pageInputs, markdown: entry.plainMarkdown, rawDescription: entry.rawDescription, fullwidth: content.fullwidth, hero: content.hero,
        meta: content.meta, sectionNavigation: content.sectionNavigation, agendaRoute, sourceRoute,
      }) } : {}),
    });
  }
  return pages;
}
const { route, sourceRoute, agendaRoute, pageInputs, hero } = Astro.props;
const loadedContent = await loadSiteContent(sourceRoute, { publication, agendaRoute });
if (!loadedContent) throw new Error(`The published page source is missing: ${route}`);
const content = hero ? { ...loadedContent, hero } : loadedContent;
const resolvedPageInputs = pageInputs ?? await publicationPageInputs({ route, title: content.title, description: content.description, accent: content.pageAccent, robots: content.robots, content });
---
<PublicPage pageInputs={resolvedPageInputs} title={content.title} description={content.description} accent={content.pageAccent} robots={content.robots} content={content}>
  <SitePageBody content={content} publication={publication} memberCount={memberCounts.organization} modelVersions={resolvedPageInputs.modelVersions} />
</PublicPage>
