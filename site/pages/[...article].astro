---
import PublicPage from "../layouts/PublicPage.astro";
import { SitePageBody } from "../../assets/ts/site/SitePageBody";
import { loadSiteContent, loadSiteContentMetadata, publishedSiteRoutes, siteMapEntries } from "../../functions/_lib/services/site-content";
import { publication, memberCounts } from "../publication";
import { publicationPageInputs } from "../publication-page-inputs";
import { publicationRouteCacheKey } from "../publication-cache";
import { renderSiteContentHero } from "../../functions/_lib/services/site-content-resolution";
export async function getStaticPaths() {
  const dedicated = new Set(["/members/", "/members/independent/", "/members/profile/", "/portal/", "/search/", "/news/", "/votes/", "/votes/detail/", "/wg/pkimm/"]);
  const routes = new Set([...publishedSiteRoutes(), ...siteMapEntries().map(({ route }) => route), ...(publication.eventFlows ?? []).map(page => page.route)]);
  const pages = [];
  for (const route of routes) {
    if (dedicated.has(route)) continue;
    const entry = await loadSiteContentMetadata(route, { publication });
    if (!entry || entry.metadata.draft || entry.metadata.redirect) continue;
    const hero = entry.plainMarkdown === undefined ? undefined : await renderSiteContentHero(entry.metadata, entry.rawDescription);
    const content = hero ? { ...entry.metadata, hero } : entry.metadata;
    const pageInputs = entry.plainMarkdown === undefined ? undefined : await publicationPageInputs({
      route, title: content.title, description: content.description, accent: content.pageAccent, robots: content.robots, content,
    });
    pages.push({
      params: { article: route === "/" ? undefined : route.replace(/^\/|\/$/g, "") },
      props: { route, pageInputs, hero },
      ...(pageInputs?.imageInputs.cacheable ? { cacheKey: publicationRouteCacheKey(route, {
        pageInputs, markdown: entry.plainMarkdown, rawDescription: entry.rawDescription, fullwidth: content.fullwidth, hero: content.hero,
        meta: content.meta, sectionNavigation: content.sectionNavigation,
      }) } : {}),
    });
  }
  return pages;
}
const { route, pageInputs, hero } = Astro.props;
const loadedContent = await loadSiteContent(route, { publication });
if (!loadedContent) throw new Error(`The published page source is missing: ${route}`);
const content = hero ? { ...loadedContent, hero } : loadedContent;
---
<PublicPage pageInputs={pageInputs} title={content.title} description={content.description} accent={content.pageAccent} robots={content.robots} content={content}>
  <SitePageBody content={content} publication={publication} memberCount={memberCounts.organization} />
</PublicPage>
