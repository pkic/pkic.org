---
import { affiliationLogoSources } from "../../assets/shared/agenda-speaker-affiliations";
import { publicationRouteCacheKey } from "../publication-cache";
import { publicationPageInputs } from "../publication-page-inputs";
import { h } from "preact";
import { renderToStringAsync as render } from "preact-render-to-string";
import { agendaContent } from "../../assets/shared/public-agenda-content";
import { AgendaCalendarLinks } from "../../assets/ts/site/AgendaCalendarLinks";
import { ContentAgenda } from "../../assets/ts/site/ContentAgenda";
import { contractClock } from "../../assets/shared/event-clock";
import { formatClockName } from "../../assets/shared/format-date";
import { publishedSiteRoutes } from "../../functions/_lib/services/site-content";
import PublicPage from "../layouts/PublicPage.astro";
import { publication } from "../publication";
import { publishedEventAgendas, publishedAgendaCalendarLinks } from "../../functions/_lib/services/site-published-event-agendas";
import { markdownImageSources } from "../publication-markdown-images";
import { publicationAuthoredAgendaRoutes, publicAgendaChildRoutes } from "../../assets/shared/publication-agenda-routes";

export async function getStaticPaths() {
  const authored = new Set(publishedSiteRoutes());
  // Authored event pages already present these agendas with their hero; their agenda URLs redirect there.
  const embedded = new Set(publicationAuthoredAgendaRoutes(publication).map((owner) => owner.eventSlug));
  return Promise.all(publishedEventAgendas(publication).filter(({ route, snapshot }) => !authored.has(route) && !embedded.has(snapshot.eventSlug)).flatMap(({ snapshot, route }) => [
    { snapshot, route, agendaBasePath: route, initialDay: undefined as string | undefined },
    ...publicAgendaChildRoutes(route, agendaContent(snapshot).days.map((day) => day.date)).map((child) => {
      if (authored.has(child.route)) throw new Error(`Agenda child collides with an authored page: ${child.route}`);
      return { snapshot, ...child };
    }),
  ]).map(async ({ snapshot, route, agendaBasePath, initialDay }) => {
    const view = {
      route, agendaBasePath, initialDay, title: `${snapshot.eventName ?? "Event"} agenda`, clock: contractClock(snapshot),
      content: agendaContent(snapshot),
      calendarLinks: publishedAgendaCalendarLinks(publication, snapshot),
    };
    const sessions = view.content.days.flatMap((day) => day.slots.flatMap((slot) => slot.sessions));
    const speakers = [...view.content.speakers, ...sessions.flatMap((session) => session.speakers)];
    const imageRefs = [
      ...speakers.map((speaker) => speaker.imageSrc).filter((source): source is string => Boolean(source))
        .map((source) => ({ source, portrait: true })),
      ...speakers.flatMap((speaker) => affiliationLogoSources(speaker.affiliations).map((source) => ({ source, portrait: true }))),
      ...markdownImageSources([...sessions.map((session) => session.descriptionMarkdown), ...speakers.map((speaker) => speaker.bioMarkdown)])
        .map((source) => ({ source, portrait: false })),
    ];
    const pageInputs = await publicationPageInputs({ route, title: view.title, imageRefs });
    return {
      params: { eventAgenda: route.replace(/^\/|\/$/g, "") }, props: { view, pageInputs },
      ...(pageInputs.imageInputs.cacheable ? { cacheKey: publicationRouteCacheKey(route, { view, pageInputs }) } : {}),
    };
  }));
}
const { view, pageInputs } = Astro.props;
const calendarHtml = await render(h(AgendaCalendarLinks, { links: view.calendarLinks }));
const html = await render(h(ContentAgenda, { ...view.content, timeZone: view.clock, fragmentNavigation: true, agendaBasePath: view.agendaBasePath, initialDay: view.initialDay }));
---
<PublicPage title={view.title} pageInputs={pageInputs}>
  <section class="pk-section pk-container pk-container--wide" data-pagefind-body>
  <h1>{view.title}</h1>
  <p>Times are {formatClockName(view.clock)}.</p>
  <div set:html={calendarHtml} />
  <div set:html={html} />
  </section>
</PublicPage>
