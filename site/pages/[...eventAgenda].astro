---
import { publicationRouteCacheKey, PUBLICATION_SITE_ORIGIN } from "../publication-cache";
import { publicationPageInputs } from "../publication-page-inputs";
import { h } from "preact";
import { renderToStringAsync as render } from "preact-render-to-string";
import { agendaContent } from "../../assets/shared/public-agenda-content";
import { ContentAgenda } from "../../assets/ts/site/ContentAgenda";
import { publishedSiteRoutes } from "../../functions/_lib/services/site-content";
import PublicPage from "../layouts/PublicPage.astro";
import { publication } from "../publication";
import { publishedEventAgendas } from "../../functions/_lib/services/site-published-event-agendas";
import { markdownImageSources } from "../publication-markdown-images";

export async function getStaticPaths() {
  const authored = new Set(publishedSiteRoutes());
  return Promise.all(publishedEventAgendas(publication).filter(({ route }) => !authored.has(route)).map(async ({ snapshot, route }) => {
    const view = {
      route, title: `${snapshot.eventName ?? "Event"} agenda`, timeZone: snapshot.timeZone,
      content: agendaContent(snapshot),
      calendarPath: `${route}calendar.ics`,
      subscribeUrl: new URL(`${route}calendar.ics`, PUBLICATION_SITE_ORIGIN).href.replace(/^https?:/, "webcal:"),
    };
    const sessions = view.content.days.flatMap((day) => day.slots.flatMap((slot) => slot.sessions));
    const speakers = [...view.content.speakers, ...sessions.flatMap((session) => session.speakers)];
    const imageRefs = [
      ...speakers.map((speaker) => speaker.imageSrc).filter((source): source is string => Boolean(source))
        .map((source) => ({ source, portrait: true })),
      ...markdownImageSources([...sessions.map((session) => session.descriptionMarkdown), ...speakers.map((speaker) => speaker.bioMarkdown)])
        .map((source) => ({ source, portrait: false })),
    ];
    const pageInputs = await publicationPageInputs({ route, title: view.title, imageRefs });
    return {
      params: { eventAgenda: route.replace(/^\/|\/$/g, "") }, props: { view, pageInputs },
      ...(pageInputs.imageInputs.cacheable ? { cacheKey: publicationRouteCacheKey(route, { view, pageInputs }) } : {}),
    };
  }));
}
const { view, pageInputs } = Astro.props;
const html = await render(h(ContentAgenda, { ...view.content, timeZone: view.timeZone, fragmentNavigation: true }));
---
<PublicPage title={view.title} pageInputs={pageInputs}>
  <section class="pk-section pk-container pk-container--wide" data-pagefind-body>
  <h1>{view.title}</h1>
  <p>Times in {view.timeZone}. <a href={view.subscribeUrl}>Subscribe to calendar</a> · <a href={view.calendarPath} download>Download calendar</a></p>
  <div set:html={html} />
  </section>
</PublicPage>
