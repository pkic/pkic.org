---
import PublicPage from "../../layouts/PublicPage.astro";
import { HeadshotDialogTemplates } from "../../../assets/ts/site/HeadshotDialogTemplates";
import { Login } from "../../../assets/ts/member-flows/portal/shell/Login";
import { loadSiteContent } from "../../../functions/_lib/services/site-content";
import { PORTAL_LOGIN_COPY_ID } from "../../../assets/shared/schemas/portal-login-copy";
import { memberCounts } from "../../publication";
const content = await loadSiteContent("/portal/");
const copy = { ...content?.portalLogin, facts: content?.portalLogin?.facts?.map((fact) => ({
  ...fact,
  value: fact.memberCount ? String(fact.memberCount === "all" ? memberCounts.organization + memberCounts.independent : memberCounts[fact.memberCount]) : fact.value,
  memberCount: undefined,
})) };
---
<PublicPage title="Member portal" privatePage>
  <Fragment slot="head">
    <link rel="manifest" href="/portal/manifest.webmanifest" />
    <meta name="theme-color" content="#0b2a1c" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="PKI Consortium" />
  </Fragment>
  <script id={PORTAL_LOGIN_COPY_ID} type="application/json" set:html={JSON.stringify(copy).replace(/</g, "\u003c")} />
  <div id="portal-app" inert><Login copy={copy} busy status="Checking your sign-in…" onSignedIn={() => {}} /></div>
  <div id="portal-toast-area" />
  <HeadshotDialogTemplates />
  <script>
    await import("../../../assets/ts/shared/browser-validation");
    await import("../../portal-entry");
  </script>
</PublicPage>
