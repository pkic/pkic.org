---
import "../../assets/design/layers.generated.css";
import "../../assets/ts/design-system";
import { SiteDocumentHead } from "../../assets/ts/site/SiteDocument";
import { SiteHeader, SiteFooter, SiteMain } from "../../assets/ts/ui/SiteChrome";
import "../../assets/ts/site/public-styles";
import { publicationPageInputs, type PublicationPageInputs } from "../publication-page-inputs";
import type { SiteContentPage } from "../../assets/shared/site-content";
import type { PublicMemberDetail } from "../../assets/shared/schemas/members-directory";

interface Props {
  pageInputs?: PublicationPageInputs;
  title: string;
  description?: string;
  privatePage?: boolean;
  accent?: string;
  robots?: string;
  content?: SiteContentPage;
  member?: PublicMemberDetail;
  structuredData?: unknown;
}
const page = Astro.props.pageInputs ?? await publicationPageInputs({ ...Astro.props, route: Astro.url.pathname });
const { title, description, privatePage, accent, robots, structuredData, clientAssets } = page;
const excludeFromSearch = privatePage || robots?.includes("noindex");
---
<html lang={page.language}>
  <head>
    <link rel="preload" href="/fonts/Roboto-latin.woff2" as="font" type="font/woff2" crossorigin />
    <SiteDocumentHead
      structuredData={privatePage ? undefined : structuredData}
      title={title}
      description={description}
      currentPath={page.route}
      canonicalUrl={page.canonicalUrl}
      assets={{}}
      robots={privatePage ? "noindex, nofollow, noarchive" : robots}
    />
    <slot name="head" />
    {!privatePage && !robots?.includes("noindex") && <template id="pkic-social-card">{JSON.stringify(page.socialCard)}</template>}
  </head>
  <body class={`pk-site${accent ? ` pk-page--${accent}` : ""}`}>
    <SiteHeader currentPath={page.route} navigation={page.navigation} memberCounts={page.memberCounts} />
    <SiteMain privatePage={excludeFromSearch}><slot /></SiteMain>
    {page.route !== "/portal/" && <template id="pkic-public-form-resources">{JSON.stringify(page.publicResources)}</template>}
    <SiteFooter navigation={page.navigation} privatePage={privatePage} memberWall={page.memberWall} copyrightYear={page.copyrightYear} />
    <script is:inline type="module" src={clientAssets.loader.url} integrity={clientAssets.loader.integrity} crossorigin="anonymous"></script>
    {clientAssets.publicSite && <script is:inline type="module" src={clientAssets.publicSite.url} integrity={clientAssets.publicSite.integrity} crossorigin="anonymous"></script>}
  </body>
</html>
