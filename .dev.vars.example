# Copy this file to `.dev.vars` for local `wrangler pages dev`.
# `.dev.vars` is gitignored.

# Required. This deployment's own canonical origin — used whenever code runs
# without an incoming request URL (email outbox, background jobs, local
# scripts), and to validate the Referer/Origin on form submissions
# (functions/api/v1/forms.ts) instead of inferring "local dev" from a
# fallback. Keep this on localhost for local dev.
APP_BASE_URL=http://localhost:8788

# Optional comma-separated trusted HTTPS image hosts for event badge hero images.
# Leave unset to permit only same-origin assets. Do not add private or internal hosts.
# HERO_IMAGE_ALLOWED_HOSTS=images.example.com,cdn.example.com

# Required for HMAC signing of internal tokens and hashed identifiers.
INTERNAL_SIGNING_SECRET=replace-with-strong-random-value

# Optional now, used for future hashed-email external feedback source.
FEEDBACK_IDENTITY_SECRET_V1=replace-with-strong-random-value

# Optional for local email sending via SendGrid.
# SENDGRID_API_KEY=replace-with-sendgrid-api-key
# FROM_EMAIL=noreply@pkic.org
# FROM_NAME=PKI Consortium
# Optional only on loopback local development. Preview and production fail
# closed unless this SendGrid Event Webhook public key is configured as a
# Wrangler secret.
# SENDGRID_WEBHOOK_VERIFICATION_KEY=replace-with-base64-p256-public-key

# Optional — only needed to test the join-membership/sponsor-interest forms
# locally (functions/_lib/services/membership-form-submission.ts). Without
# it, submitting either form throws immediately ("GITHUB_TOKEN is not
# configured") since there's no other path for the submission to land
# anywhere. It authorizes three GitHub API calls per submission:
#   1. Creates the issue in pkic/members that the application is tracked
#      and reviewed through.
#   2. Searches pkic/pkic.org's merged member YAML profiles
#      (data/members/*.yaml) for the applicant's email domain, to flag
#      likely-duplicate organizations that are already members.
#   3. Falls back to searching open pkic/members issues for the same
#      domain, to catch a pending application that hasn't been merged yet.
# Needs read/write access to issues in pkic/members and read access to
# pkic/pkic.org.
# GITHUB_TOKEN=replace-with-github-token
