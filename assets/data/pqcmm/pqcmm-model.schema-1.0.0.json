{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkic.org/wg/pqc/pqcmm/data/pqcmm-model.schema-1.0.0.json",
  "title": "PQC Maturity Model",
  "description": "Schema for a versioned, machine-readable PQCMM model definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model", "scoring", "levels"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "abbreviation", "version", "scope", "subjectLabel", "description", "canonicalUrl"],
      "properties": {
        "id": { "const": "pqcmm" },
        "name": { "type": "string", "minLength": 1 },
        "abbreviation": { "const": "PQCMM" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "scope": { "const": "product-or-service" },
        "subjectLabel": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "format": "uri" }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "minimumLevel", "maximumLevel", "criterionStatuses", "rule"],
      "properties": {
        "method": { "const": "cumulative-all-criteria" },
        "minimumLevel": { "const": 0 },
        "maximumLevel": { "const": 5 },
        "criterionStatuses": {
          "const": ["not-assessed", "met", "not-met", "partial"]
        },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "markdown": { "type": "string" },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-5]\\.1\\.[1-9][0-9]*$" },
        "text": { "$ref": "#/$defs/markdown" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-5]\\.[0-9]+\\.[0-9]+$" },
        "question": { "$ref": "#/$defs/markdown" },
        "guidance": { "$ref": "#/$defs/markdown" },
        "expectedInput": { "$ref": "#/$defs/markdown" },
        "purpose": { "$ref": "#/$defs/markdown" }
      },
      "oneOf": [
        { "required": ["guidance"] },
        { "required": ["expectedInput", "purpose"] }
      ]
    },
    "questionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-5]\\.[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["assessment", "intake"] },
        "introduction": { "$ref": "#/$defs/markdown" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-5]\\.e\\.[1-9][0-9]*$" },
        "text": { "$ref": "#/$defs/markdown" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "title", "description", "summary", "sourcePage", "criteria", "assessment", "evidenceChecklist"],
      "properties": {
        "number": { "type": "integer", "minimum": 0, "maximum": 5 },
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sourcePage": { "type": "string", "pattern": "^/wg/pqc/pqcmm/levels/" },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introduction", "items"],
          "properties": {
            "introduction": { "$ref": "#/$defs/markdown" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/criterion" }
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methodology", "groups"],
          "properties": {
            "methodology": { "$ref": "#/$defs/markdown" },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/questionGroup" }
            }
          }
        },
        "evidenceChecklist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introduction", "items"],
          "properties": {
            "introduction": { "$ref": "#/$defs/markdown" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidenceItem" }
            }
          }
        }
      }
    }
  }
}
