{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkic-org-base",
  "account_id": "dd9c5d7f73f7d170f3e2c1108fc84bb3",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "functions/worker.ts",
  "exports": {
    "PublicRead": { "type": "worker", "cache": { "enabled": true } },
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "pkic-org",
      "worker_loaders": [{ "binding": "LOADER" }],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "fda3b4a29dc54c49a2e6a44a92e324f3",
        },
      ],
      "triggers": {
        "crons": ["* * * * *"],
      },
      "routes": [
        {
          "pattern": "pkic.org",
          "custom_domain": true,
        },
      ],
      "assets": {
        "directory": "./public/",
        "binding": "ASSETS_PUBLIC",
        "not_found_handling": "404-page",
        "run_worker_first": [
          "/api/*",
          "/.well-known/oauth-authorization-server",
          "/.well-known/oauth-protected-resource",
          "/.well-known/oauth-protected-resource/*",
          "/r/*",
          "/donate/r/*",
        ],
      },
      "preview_urls": true,
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pkic-db",
          "database_id": "705d4a53-c607-4b4f-bf90-74fc1c079d37",
          "preview_database_id": "0647ba62-4bf0-40e5-b547-62f992acbbf0",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "pkic-assets",
        },
        {
          "binding": "SPEAKER_UPLOADS_BUCKET",
          "bucket_name": "pkic-speaker-uploads",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "ratelimits": [
        {
          "name": "EMAIL_RATE_LIMITER",
          "namespace_id": "910001",
          "simple": {
            "limit": 3,
            "period": 60,
          },
        },
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "910002",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
      "vars": {
        // Set true only after provisioning TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES
        // (exact frontend hostnames), and the TURNSTILE_SECRET Worker secret.
        // Keep preview and production configuration separate. False disables the gate.
        "TURNSTILE_ENABLED": "true",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE6XHgcF51m-GKnM",
        "TURNSTILE_HOSTNAMES": "pkic.org",
        // Emergency mode never expires. Planned windows require both UTC instants.
        "SERVICE_MODE": "normal",
        // Validate schedule edits with pnpm maintenance:preview <schedule.json>; deployment publishes this snapshot.
        "MAINTENANCE_SCHEDULE": "{\"version\":1,\"windows\":[]}",
        "APP_BASE_URL": "https://pkic.org",
        "PUBLIC_READ_BROWSER_TTL_SECONDS": "3600",
        "PUBLIC_READ_CDN_TTL_SECONDS": "86400",
        "DEFAULT_MIN_PROPOSAL_REVIEWS": "2",
        "DEFAULT_REFERRAL_CODE_LENGTH": "7",
        "DEFAULT_INVITE_LIMIT_PER_ATTENDEE": "50",
        "WAITLIST_CLAIM_WINDOW_HOURS": "24",
        "MAGIC_LINK_TTL_MINUTES": "15",
        "CONFIRMATION_LINK_TTL_HOURS": "48",
        "MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "3600",
        "MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS": "28800",
        "REMINDER_INTERVAL_DAYS": "7",
        "MAX_INVITE_REMINDERS": "12",
        "MAX_PRESENTATION_REMINDERS": "12",
        "PRESENTATION_REMINDER_LEAD_DAYS": "60",
        "SCHEDULED_REMINDER_LIMIT": "100",
        "SCHEDULED_OUTBOX_LIMIT": "100",
        "SCHEDULED_STORAGE_DELETION_LIMIT": "25",
        "SCHEDULED_WAITLIST_PROMOTION_LIMIT": "50",
        "SCHEDULED_RSVP_ENFORCEMENT_LIMIT": "25",
        "SCHEDULED_DUE_WORK_MAX_PASSES": "50",
        "SCHEDULED_DUE_WORK_MAX_MS": "600000",
        "SCHEDULED_D1_QUERY_BUDGET": "900",
        "SCHEDULED_ON_HOLD_REMINDER_LIMIT": "100",
        "SCHEDULED_GOOGLE_GROUPS_SYNC_LIMIT": "25",
        "CSV_EXPORT_MAX_ROWS": "5000",
        "CSV_EXPORT_MAX_BYTES": "8388608",
        "APPLICATION_DOCUMENT_MAX_BYTES": "20971520",
        "APPLICATION_DOCUMENT_MAX_COUNT": "20",
        "APPLICATION_DOCUMENT_TOTAL_MAX_BYTES": "104857600",
        "SCHEDULED_VOTE_DUE_WORK_LIMIT": "50",
        "SCHEDULED_VOTE_NOTIFICATION_LIMIT": "100",
        "SENDGRID_API_BASE": "https://api.sendgrid.com/v3/mail/send",
        "SPEAKER_UPLOAD_DEADLINE_DAYS": "21",
        "FROM_EMAIL": "noreply@pkic.org",
        "RSVP_EMAIL": "rsvp@mail.pkic.org",
        "RSVP_INBOUND_EMAIL_MAX_BYTES": "5242880",
        "FROM_NAME": "PKI Consortium",
        "STRIPE_PUBLISHABLE_KEY": "pk_live_51TADczLT173BlQwOkLRjg7nIK7sX9gZJj4DAvD30X8mKpP3Zu3ksMmMk6GYE2moavKccbH3VBqCHDF09mAlny3kg00pZN2Ke0d",
        "WEBAUTHN_RP_ID": "pkic.org",
        "WEBAUTHN_RP_NAME": "PKI Consortium",
        "WEBAUTHN_ORIGIN": "https://pkic.org",
      },
      // Branch and pull-request Previews (`wrangler preview`) inherit nothing
      // above. Every binding the code reads is declared here against a preview
      // resource; never bind a production database, bucket, or namespace.
      "previews": {
        "worker_loaders": [{ "binding": "LOADER" }],
        "kv_namespaces": [
          {
            "binding": "OAUTH_KV",
            "id": "5c0850c6b3a84a2f9ec97d0f39fe2019",
          },
        ],
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "pkic-db-preview",
            "database_id": "0647ba62-4bf0-40e5-b547-62f992acbbf0",
          },
        ],
        "r2_buckets": [
          {
            "binding": "ASSETS_BUCKET",
            "bucket_name": "pkic-assets-preview",
          },
          {
            "binding": "SPEAKER_UPLOADS_BUCKET",
            "bucket_name": "pkic-speaker-uploads-preview",
          },
        ],
        "images": {
          "binding": "IMAGES",
        },
        "ratelimits": [
          {
            "name": "EMAIL_RATE_LIMITER",
            "namespace_id": "910101",
            "simple": {
              "limit": 3,
              "period": 60,
            },
          },
          {
            "name": "IP_RATE_LIMITER",
            "namespace_id": "910102",
            "simple": {
              "limit": 20,
              "period": 60,
            },
          },
        ],
        // APP_BASE_URL and WEBAUTHN_ORIGIN are each Preview's own branch URL,
        // injected at build time by vite.config.ts. Turnstile stays disabled,
        // so no Preview hostname list is configured.
        "vars": {
          "TURNSTILE_ENABLED": "false",
          "TURNSTILE_SITE_KEY": "0x4AAAAAAE6XfYe1tYFi5T0U",
          "SERVICE_MODE": "normal",
          "MAINTENANCE_SCHEDULE": "{\"version\":1,\"windows\":[]}",
          "PUBLIC_READ_BROWSER_TTL_SECONDS": "3600",
          "PUBLIC_READ_CDN_TTL_SECONDS": "86400",
          "DEFAULT_MIN_PROPOSAL_REVIEWS": "2",
          "DEFAULT_REFERRAL_CODE_LENGTH": "7",
          "DEFAULT_INVITE_LIMIT_PER_ATTENDEE": "50",
          "WAITLIST_CLAIM_WINDOW_HOURS": "24",
          "MAGIC_LINK_TTL_MINUTES": "15",
          "CONFIRMATION_LINK_TTL_HOURS": "48",
          "MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "3600",
          "MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS": "28800",
          "REMINDER_INTERVAL_DAYS": "7",
          "MAX_INVITE_REMINDERS": "12",
          "MAX_PRESENTATION_REMINDERS": "12",
          "PRESENTATION_REMINDER_LEAD_DAYS": "60",
          "SCHEDULED_REMINDER_LIMIT": "100",
          "SCHEDULED_OUTBOX_LIMIT": "100",
          "SCHEDULED_STORAGE_DELETION_LIMIT": "25",
          "SCHEDULED_WAITLIST_PROMOTION_LIMIT": "50",
          "SCHEDULED_RSVP_ENFORCEMENT_LIMIT": "25",
          "SCHEDULED_DUE_WORK_MAX_PASSES": "50",
          "SCHEDULED_DUE_WORK_MAX_MS": "600000",
          "SCHEDULED_D1_QUERY_BUDGET": "900",
          "SCHEDULED_ON_HOLD_REMINDER_LIMIT": "100",
          "SCHEDULED_GOOGLE_GROUPS_SYNC_LIMIT": "25",
          "CSV_EXPORT_MAX_ROWS": "5000",
          "CSV_EXPORT_MAX_BYTES": "8388608",
          "APPLICATION_DOCUMENT_MAX_BYTES": "20971520",
          "APPLICATION_DOCUMENT_MAX_COUNT": "20",
          "APPLICATION_DOCUMENT_TOTAL_MAX_BYTES": "104857600",
          "SCHEDULED_VOTE_DUE_WORK_LIMIT": "50",
          "SCHEDULED_VOTE_NOTIFICATION_LIMIT": "100",
          "SENDGRID_API_BASE": "https://api.sendgrid.com/v3/mail/send",
          "SPEAKER_UPLOAD_DEADLINE_DAYS": "21",
          "FROM_EMAIL": "noreply@pkic.org",
          "RSVP_EMAIL": "rsvp-preview@mail.pkic.org",
          "RSVP_INBOUND_EMAIL_MAX_BYTES": "5242880",
          "FROM_NAME": "PKI Consortium (Preview)",
          "STRIPE_PUBLISHABLE_KEY": "pk_test_51TADczLT173BlQwOCJAhV0Mf5xxJXJWG9VWkprhXUSJZTaYdqr5vJynipzUfCglU93cIoCBBNOkviwhOqQ3ZFPNk00cxzuEyMH",
          "WEBAUTHN_RP_ID": "pkic.workers.dev",
          "WEBAUTHN_RP_NAME": "PKI Consortium (Preview)",
          "WEBAUTHN_PREVIEW_WORKER_NAME": "pkic-org",
        },
      },
    },
    "local": {
      "name": "pkic-org-local",
      "worker_loaders": [{ "binding": "LOADER" }],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "fda3b4a29dc54c49a2e6a44a92e324f3",
        },
      ],
      "assets": {
        "directory": "./public/",
        "binding": "ASSETS_PUBLIC",
        "not_found_handling": "404-page",
        "run_worker_first": [
          "/api/*",
          "/.well-known/oauth-authorization-server",
          "/.well-known/oauth-protected-resource",
          "/.well-known/oauth-protected-resource/*",
          "/r/*",
          "/donate/r/*",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pkic-db-local",
          "database_id": "705d4a53-c607-4b4f-bf90-74fc1c079d37",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "pkic-assets",
        },
        {
          "binding": "SPEAKER_UPLOADS_BUCKET",
          "bucket_name": "pkic-speaker-uploads",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "ratelimits": [
        {
          "name": "EMAIL_RATE_LIMITER",
          "namespace_id": "910201",
          "simple": {
            "limit": 3,
            "period": 60,
          },
        },
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "910202",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
      "vars": {
        // Set true only after provisioning TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES
        // (exact frontend hostnames), and the TURNSTILE_SECRET Worker secret.
        // Keep preview and production configuration separate. False disables the gate.
        "TURNSTILE_ENABLED": "false",
        // Emergency mode never expires. Planned windows require both UTC instants.
        "SERVICE_MODE": "normal",
        // Validate schedule edits with pnpm maintenance:preview <schedule.json>; deployment publishes this snapshot.
        "MAINTENANCE_SCHEDULE": "{\"version\":1,\"windows\":[]}",
        "PUBLIC_READ_BROWSER_TTL_SECONDS": "3600",
        "PUBLIC_READ_CDN_TTL_SECONDS": "86400",
        "DEFAULT_MIN_PROPOSAL_REVIEWS": "2",
        "DEFAULT_REFERRAL_CODE_LENGTH": "7",
        "DEFAULT_INVITE_LIMIT_PER_ATTENDEE": "50",
        "WAITLIST_CLAIM_WINDOW_HOURS": "24",
        "MAGIC_LINK_TTL_MINUTES": "15",
        "CONFIRMATION_LINK_TTL_HOURS": "48",
        "MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "3600",
        "MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS": "28800",
        "REMINDER_INTERVAL_DAYS": "7",
        "MAX_INVITE_REMINDERS": "12",
        "MAX_PRESENTATION_REMINDERS": "12",
        "PRESENTATION_REMINDER_LEAD_DAYS": "60",
        "SCHEDULED_REMINDER_LIMIT": "100",
        "SCHEDULED_OUTBOX_LIMIT": "100",
        "SCHEDULED_STORAGE_DELETION_LIMIT": "25",
        "SCHEDULED_WAITLIST_PROMOTION_LIMIT": "50",
        "SCHEDULED_RSVP_ENFORCEMENT_LIMIT": "25",
        "SCHEDULED_DUE_WORK_MAX_PASSES": "50",
        "SCHEDULED_DUE_WORK_MAX_MS": "600000",
        "SCHEDULED_D1_QUERY_BUDGET": "900",
        "SCHEDULED_ON_HOLD_REMINDER_LIMIT": "100",
        "SCHEDULED_GOOGLE_GROUPS_SYNC_LIMIT": "25",
        "CSV_EXPORT_MAX_ROWS": "5000",
        "CSV_EXPORT_MAX_BYTES": "8388608",
        "APPLICATION_DOCUMENT_MAX_BYTES": "20971520",
        "APPLICATION_DOCUMENT_MAX_COUNT": "20",
        "APPLICATION_DOCUMENT_TOTAL_MAX_BYTES": "104857600",
        "SCHEDULED_VOTE_DUE_WORK_LIMIT": "50",
        "SCHEDULED_VOTE_NOTIFICATION_LIMIT": "100",
        "SENDGRID_API_BASE": "https://api.sendgrid.com/v3/mail/send",
        "SPEAKER_UPLOAD_DEADLINE_DAYS": "21",
        "FROM_EMAIL": "noreply@pkic.org",
        "RSVP_EMAIL": "rsvp-local@mail.pkic.org",
        "RSVP_INBOUND_EMAIL_MAX_BYTES": "5242880",
        "FROM_NAME": "PKI Consortium",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51TADczLT173BlQwOCJAhV0Mf5xxJXJWG9VWkprhXUSJZTaYdqr5vJynipzUfCglU93cIoCBBNOkviwhOqQ3ZFPNk00cxzuEyMH",
        "WEBAUTHN_RP_ID": "localhost",
        "WEBAUTHN_RP_NAME": "PKI Consortium (Local)",
        "WEBAUTHN_ORIGIN": "http://localhost:8788",
      },
    },
  },
}
