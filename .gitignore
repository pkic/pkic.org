# macOS Finder and AppleDouble metadata
.DS_Store
._*
.AppleDouble/
public
dist
resources/_gen/
static/pagefind
.dev.vars
wrangler.toml
.env*
test-results/
# Playwright writes one output directory per run; parallel runs in this
# worktree use suffixed ones so they cannot clobber each other's artifacts.
test-results*/
playwright-report/
ignore/
prd/
sven-test-csv/

# Vite-built frontend bundle manifest and static output (generated by scripts/build-frontend.mjs)
data/asset-manifest.json
static/js/built/
backups/

# Ignore hugo itself when located here
hugo
hugo.*
static/_pagefind

# Python cache
.venv
__pycache__/
*.py[cod]
*$py.class

# Cloudflare
.wrangler/
.cache/
node_modules/

# jscpd duplication report (regenerate with `pnpm run lint:duplication`)
.jscpd-report/
.ds-sync/
ds-bundle/
# Google Groups roster exports feeding scripts/migrate-members. Populated they
# hold member names and addresses, which is personal data and does not belong
# in the repository; the scripts read whatever the operator puts here.
csv/
prod-csv/

# Local assistant and design synchronization files
/.claude/
/.design-sync/
types/

# Local migration and rehearsal documentation
/docs/local-dev-with-production-backup.md
/docs/yaml-to-d1-member-migration.md
